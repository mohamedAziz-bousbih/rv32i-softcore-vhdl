# Quartus Prime Lite project settings for the RV32I SoC on the DE10-Lite.
#
# Pin numbers and I/O standards are taken from the Terasic DE10-Lite User
# Manual (V1.4, January 2017), tables 3-2 (clock), 3-3 (push-buttons),
# 3-4 (slide switches), 3-5 (LEDs) and 3-7 (expansion header).
#
# Synthesis with these settings has not been run yet (see README).

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10lite_top
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# The ROM and RAM contents come from the bitstream. MAX 10 can only
# initialise block memory in a configuration mode with memory
# initialisation ("ERAM").
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"

set_global_assignment -name VHDL_FILE ../../rtl/core/rv32i_pkg.vhd
set_global_assignment -name VHDL_FILE ../../rtl/core/rv32i_alu.vhd
set_global_assignment -name VHDL_FILE ../../rtl/core/rv32i_regfile.vhd
set_global_assignment -name VHDL_FILE ../../rtl/core/rv32i_core.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/soc_pkg.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/uart_tx.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/rom_dp.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/ram_be.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/soc_mmio.vhd
set_global_assignment -name VHDL_FILE ../../rtl/soc/rv32i_soc.vhd
set_global_assignment -name VHDL_FILE rom_image_pkg.vhd
set_global_assignment -name VHDL_FILE de10lite_top.vhd
set_global_assignment -name SDC_FILE de10lite.sdc

# Clock (table 3-2)
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50

# Push-button KEY0 (table 3-3), debounced by a Schmitt trigger on the board
set_location_assignment PIN_B8 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to KEY[0]

# Slide switches (table 3-4)
set_location_assignment PIN_C10 -to SW[0]
set_location_assignment PIN_C11 -to SW[1]
set_location_assignment PIN_D12 -to SW[2]
set_location_assignment PIN_C12 -to SW[3]
set_location_assignment PIN_A12 -to SW[4]
set_location_assignment PIN_B12 -to SW[5]
set_location_assignment PIN_A13 -to SW[6]
set_location_assignment PIN_A14 -to SW[7]
set_location_assignment PIN_B14 -to SW[8]
set_location_assignment PIN_F15 -to SW[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[*]

# LEDs (table 3-5)
set_location_assignment PIN_A8 -to LEDR[0]
set_location_assignment PIN_A9 -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]

# UART transmit on expansion header signal GPIO_0 (table 3-7)
set_location_assignment PIN_V10 -to UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TX
